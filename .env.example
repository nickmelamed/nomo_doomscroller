# Common — required regardless of DATA_SOURCE.
ANTHROPIC_API_KEY=
SLACK_WEBHOOK_URL=

# Optional — defaults shown are what config.py uses if unset.
ANTHROPIC_MODEL=claude-sonnet-5
DATA_SOURCE=sheets
NEWS_WINDOW_HOURS=24
MAX_ITEMS_PER_SECTION=6
MONITOR_EXISTING_PARTNERS=false
MONITOR_MAX_USES=3
SCOUT_MAX_USES=8
# Logs each rejected scouting candidate + a one-line reason at Stage 5, for
# diagnosing the relevance bar. On by default; set to false to quiet it down.
SYNTHESIS_VERBOSE_LOG=true

# for private previews 
SLACK_PREVIEW_WEBHOOK_URL=

# Used when DATA_SOURCE=sheets (active in v1) — required only for this backend.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEETS_URL=

# Used when DATA_SOURCE=notion (built, dormant until switched on) — required
# only for this backend. Fine to leave blank while running on sheets.
NOTION_API_KEY=
NOTION_WATCHLIST_DB_ID=
NOTION_CRITERIA_PAGE_ID=
NOTION_TOPICS_DB_ID=
NOTION_PARTNERS_DB_ID=
NOTION_DB_URL=
